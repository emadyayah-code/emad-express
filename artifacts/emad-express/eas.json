{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "emadexpress.ayadicmed.com"
      },
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "emadexpress.ayadicmed.com"
      },
      "installCommand": "pnpm install --no-frozen-lockfile"
    }
  },
  "submit": {
    "production": {}
  }
}
