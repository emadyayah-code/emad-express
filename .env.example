NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-min-32-characters
UPLOADS_DIR=./assets/uploads
ADMIN_PANEL_DIR=./artifacts/admin-panel/dist/public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DATABASE_URL=postgresql://your_database_user:your_database_password@localhost:5432/your_database_name

# CORS - set your frontend domain, or * for all (not recommended in production)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Security
BCRYPT_ROUNDS=12
JWT_EXPIRY_HOURS=24
MAX_FILE_SIZE_MB=5
TRUST_PROXY=false

# Logging
LOG_LEVEL=info

# AliExpress Open Platform API (Dropshipping)
# Get these from: https://openservice.aliexpress.com/
# 1. aliexpress_app_key = Your App Key
# 2. aliexpress_app_key_secret = Your App Secret
# 3. aliexpress_tracking_id = Your Affiliate Tracking ID (optional)
# Add these in Admin Panel > Settings > Platform Settings, NOT in .env

# =============================================================================
# SMTP EMAIL CONFIGURATION (Required for email verification)
# =============================================================================
# You can use Gmail, Outlook, SendGrid, Resend, or any SMTP provider
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Example for SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@emadexpress.com

# =============================================================================
# PLATFORM API KEYS (Stripe, AliExpress, Amazon, Alibaba)
# =============================================================================
# These are managed via the Admin Panel > Settings > Platform Settings
# and stored in the database (platform_settings table).
# You do NOT need to add them here in .env
#
# Go to: http://localhost:3000/admin/affiliate-settings
# =============================================================================

# If you prefer environment variables over DB storage, uncomment below:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# ALIEXPRESS_APP_KEY=your_key
# ALIEXPRESS_APP_SECRET=your_secret
# ALIEXPRESS_TRACKING_ID=your_tracking_id
# AMAZON_ACCESS_KEY=your_key
# AMAZON_SECRET_KEY=your_secret
# AMAZON_PARTNER_TAG=your_tag-20
# ALIBABA_APP_KEY=your_key
# ALIBABA_APP_SECRET=your_secret
