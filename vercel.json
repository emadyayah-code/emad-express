{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/sync-stock",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/auto-import",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
